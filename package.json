    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^12.0.2",
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.8",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "file-type": "^22.1.1",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4"
