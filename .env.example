NODE_ENV=
PORT=
APP_NAME=
CORS_ORIGINS=
# Proksi ortida ishlasangiz: son (proksi qatlamlari, masalan 1), 'loopback' (shu kompyuterdagi tunnel/proksi) yoki 'true' (barchasiga ishonish — xavfli).
# Bo'sh bo'lsa X-Forwarded-For hisobga olinmaydi (soxtalashtirib bo'lmaydi).
TRUST_PROXY=

DATABASE_URL=
REDIS_URL=

JWT_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_SECURE=
OTP_DEV_ECHO=
OTP_DEV_ECHO_AUTH=


SMTP_USER=
SMTP_PORT=
SMTP_HOST=
SMTP_FROM=
SMTP_PASSWORD=

# Faqat OTHER/agregator provayderlar uchun (Click/Payme'ning o'zi bu ikkalasini ishlatmaydi).
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
# Click/Payme checkout'dan muvaffaqiyatli to'lovdan keyin qaytariladigan frontend manzili (bo'sh bo'lsa CORS_ORIGINS'dagi birinchi manzil ishlatiladi).
PAYMENT_RETURN_URL=
# Platforma komissiyasi ulushi (0.03 = 3%) — admin hisobotidagi "Ilova sof foydasi" shundan hisoblanadi.
PLATFORM_COMMISSION_RATE=
# Click merchant kabinet (my.click.uz) dan olinadi: Merchant ID, Service ID, Secret key.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme business kabinet (business.payme.uz) dan olinadi: Kassa (Merchant) ID va Key.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# false qilinsa checkout.paycom.uz (production) ishlatiladi, aks holda checkout.test.paycom.uz (sandbox).
PAYME_TEST_MODE=true
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_MAX_UPLOAD_SIZE_BYTES=
STORAGE_SIGNED_URL_TTL_SECONDS=

CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

AI_CLASSIFICATION_URL=
AI_CLASSIFICATION_API_KEY=
AI_CLASSIFICATION_TIMEOUT_MS=
# OpenAI (xatolarni AI bilan tahlil qilish uchun)
OPENAI_API_KEY=

OUTBOX_JOB_ATTEMPTS=
OUTBOX_JOB_BACKOFF_MS=

ADMIN_PHONE=
ADMIN_PASSWORD=
METRICS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_CHAT_ID=
# OTP guruhi mavzular (topic) rejimida bo'lsa — mavzu ID si (t.me/c/<guruh>/<mavzu> havolasidagi oxirgi son).
TELEGRAM_OTP_THREAD_ID=
# Yangi foydalanuvchi login/paroli yuboriladigan YOPIQ guruh (faqat superadmin a'zo bo'lsin). Bo'sh bo'lsa OTP guruhi ishlatiladi.
TELEGRAM_CREDENTIALS_CHAT_ID=
# Guruh mavzulari (topic) rejimida bo'lsa — mavzu ID si (t.me/c/<guruh>/<mavzu> havolasidagi oxirgi son). Aks holda bo'sh.
TELEGRAM_CREDENTIALS_THREAD_ID=
# Xavfsizlik hodisalari (mavjud raqam bilan ro'yxatdan o'tishga urinish va h.k.) mavzusi; bo'sh bo'lsa credentials mavzusi.
TELEGRAM_SECURITY_THREAD_ID=
# Foydalanuvchilarning kirish/chiqish hodisalari mavzusi; bo'sh bo'lsa credentials mavzusi.
TELEGRAM_SESSIONS_THREAD_ID=
TELEGRAM_CHAT_ID=
# Bot hech qachon xabar yubormaydigan guruhlar (vergul bilan ajratilgan chat ID lar)
TELEGRAM_BLOCKED_CHAT_IDS=
# Xato ogohlantirishlari mavzusi (bo'sh bo'lsa xavfsizlik mavzusi)
TELEGRAM_ALERTS_THREAD_ID=
TELEGRAM_ALERT_MIN_STATUS=

ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_MINUTES=

MAX_ACTIVE_DEVICES=

DEVICE_TRUST_SECONDS=

LOGIN_MAX_FAILURES=
LOGIN_FAILURE_WINDOW_SECONDS=
LOGIN_LOCK_SECONDS=
OTP_TTL_SECONDS=
OTP_RESEND_SECONDS=120
# Bir telefon uchun soatiga ko‘pi bilan 3 ta kod (login, qayta yuborish va SMS ham sanaladi)
OTP_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS=3
OTP_IP_MULTIPLIER=
OTP_MAX_ATTEMPTS=


RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW_SECONDS=

RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_SECONDS=

RATE_LIMIT_OTP_REQUEST_MAX=3
RATE_LIMIT_OTP_REQUEST_WINDOW_SECONDS=3600

RATE_LIMIT_OTP_VERIFY_MAX=
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=

RATE_LIMIT_CHAT_MAX=
RATE_LIMIT_CHAT_WINDOW_SECONDS=
RATE_LIMIT_CHAT_IP_MAX=

TELEGRAM_ALERT_DEDUPE_SECONDS=

# Manzil kiritish (xarita/qidiruv). Kalit bo'sh bo'lsa OpenStreetMap ishlatiladi.
YANDEX_GEOCODER_API_KEY=
YANDEX_SUGGEST_API_KEY=


# Kuchayib boruvchi blok (kirish/ro'yxatdan o'tish/OTP urinishlari): oynada MAX dan ko'p urinish -> zinapoyadagi birinchi muddatga (soniya) bloklanadi;
# 24 soat (STRIKE_WINDOW) ichida takrorlansa muddat keyingi qiymatga o'sadi: 5 daqiqa -> 15 daqiqa -> 1 soat -> 6 soat -> 24 soat.
RATE_LIMIT_ESCALATION=true
RATE_LIMIT_ESCALATION_MAX=3
RATE_LIMIT_ESCALATION_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_LADDER=300,900,3600,21600,86400
RATE_LIMIT_STRIKE_WINDOW_SECONDS=86400

# Google orqali ro‘yxatdan o‘tish/kirish (Google Cloud Console → OAuth client ID, turi: Web). Bo‘sh bo‘lsa — tugma ko‘rinmaydi.
GOOGLE_CLIENT_ID=

# --- Productionga chiqishdan oldin tekshiring ---
# NODE_ENV=production            (xavfsiz bo‘lmagan sozlamada server ishga tushmaydi)
# OTP_DEV_ECHO= va OTP_DEV_ECHO_AUTH= bo‘sh/false bo‘lsin (OTP kodi javobda qaytmasligi uchun)
# METRICS_TOKEN= majburiy: uzun tasodifiy qiymat (bo‘sh bo‘lsa /metrics yopiq qoladi)
# AUTH_COOKIE_SECURE=true, AUTH_COOKIE_SAME_SITE=lax (APK uchun none), CORS_ORIGINS — faqat o‘z domenlaringiz
# Umumiy IP chegarasi (so‘rov/daqiqa); productionda TRUST_PROXY to‘g‘ri sozlangan bo‘lishi shart, aks holda barcha foydalanuvchilar bitta IP hisoblanadi
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# ===== Frontend (apps/web, Vite) — BITTA .env shu fayl (nusxasi: cp .env.example .env); apps/web ichida .env fayllari yo'q =====
# Faqat VITE_ bilan boshlanganlar brauzer kodiga o'tadi. Panel roli rejimdan olinadi: `npm run dev:customer|master|admin`.
# Google client ID: yuqoridagi GOOGLE_CLIENT_ID backend bilan umumiy ishlatiladi (alohida VITE_GOOGLE_CLIENT_ID shart emas).
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Dev serverda asosiy saytdan mijoz/usta paneliga o'tish manzillari (production build'ga ta'sir qilmaydi)
VITE_DEV_CUSTOMER_URL=http://localhost:5173
VITE_DEV_MASTER_URL=http://localhost:5174
# Production'da asosiy sayt panellar manzilini shu yerdan oladi (bo'sh bo'lsa: /mijoz va /usta)
# VITE_CUSTOMER_URL=
# VITE_MASTER_URL=
# VITE_GOOGLE_PHONE=1

# Audio/video qo'ng'iroqlar (WebRTC). Bo'sh bo'lsa ommaviy Google STUN ishlatiladi.
# Qattiq NAT / mobil internet uchun TURN (coturn, use-auth-secret) kerak:
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
# CALL_RING_SECONDS=45

# Qo'ng'iroq yozuvlari: tugagach Telegram guruhiga yuboriladi va tizimda SAQLANMAYDI (bazada ham, omborda ham yo'q).
# Video qo'ng'iroqlar TELEGRAM_VIDEO_CALL, audio qo'ng'iroqlar TELEGRAM_AUDIO_CALL guruhiga boradi. Qiymat: guruh ID si (mavzulari bo'lsa guruhID:mavzuID).
# Bot guruhda admin bo'lishi kerak. Bo'sh bo'lsa yozuv shunchaki o'chiriladi.
TELEGRAM_VIDEO_CALL=
TELEGRAM_AUDIO_CALL=
