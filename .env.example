NODE_ENV=
PORT=
APP_NAME=
CORS_ORIGINS=
# Proksi ortida ishlasangiz: son (proksi qatlamlari, masalan 1), 'loopback' (shu kompyuterdagi tunnel/proksi) yoki 'true' (barchasiga ishonish — xavfli).
# Bo'sh bo'lsa X-Forwarded-For hisobga olinmaydi (soxtalashtirib bo'lmaydi).
TRUST_PROXY=

DATABASE_URL=
REDIS_URL=

JWT_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_SECURE=
OTP_DEV_ECHO=
OTP_DEV_ECHO_AUTH=


SMTP_USER=
SMTP_PORT=
SMTP_HOST=
SMTP_FROM=
SMTP_PASSWORD=

# Faqat OTHER/agregator provayderlar uchun (Click/Payme'ning o'zi bu ikkalasini ishlatmaydi).
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
# Click/Payme checkout'dan muvaffaqiyatli to'lovdan keyin qaytariladigan frontend manzili (bo'sh bo'lsa CORS_ORIGINS'dagi birinchi manzil ishlatiladi).
PAYMENT_RETURN_URL=
# Platforma komissiyasi ulushi (0.03 = 3%) — admin hisobotidagi "Ilova sof foydasi" shundan hisoblanadi.
PLATFORM_COMMISSION_RATE=
# Click merchant kabinet (my.click.uz) dan olinadi: Merchant ID, Service ID, Secret key.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme business kabinet (business.payme.uz) dan olinadi: Kassa (Merchant) ID va Key.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# false qilinsa checkout.paycom.uz (production) ishlatiladi, aks holda checkout.test.paycom.uz (sandbox).
PAYME_TEST_MODE=true
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_MAX_UPLOAD_SIZE_BYTES=
STORAGE_SIGNED_URL_TTL_SECONDS=

CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

AI_CLASSIFICATION_URL=
AI_CLASSIFICATION_API_KEY=
AI_CLASSIFICATION_TIMEOUT_MS=
# OpenAI (xatolarni AI bilan tahlil qilish uchun)
OPENAI_API_KEY=

OUTBOX_JOB_ATTEMPTS=
OUTBOX_JOB_BACKOFF_MS=

ADMIN_PHONE=
ADMIN_PASSWORD=
METRICS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_CHAT_ID=
# OTP guruhi mavzular (topic) rejimida bo'lsa — mavzu ID si (t.me/c/<guruh>/<mavzu> havolasidagi oxirgi son).
TELEGRAM_OTP_THREAD_ID=
# Yangi foydalanuvchi login/paroli yuboriladigan YOPIQ guruh (faqat superadmin a'zo bo'lsin). Bo'sh bo'lsa OTP guruhi ishlatiladi.
TELEGRAM_CREDENTIALS_CHAT_ID=
# Guruh mavzulari (topic) rejimida bo'lsa — mavzu ID si (t.me/c/<guruh>/<mavzu> havolasidagi oxirgi son). Aks holda bo'sh.
TELEGRAM_CREDENTIALS_THREAD_ID=
# Xavfsizlik hodisalari (mavjud raqam bilan ro'yxatdan o'tishga urinish va h.k.) mavzusi; bo'sh bo'lsa credentials mavzusi.
TELEGRAM_SECURITY_THREAD_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_MIN_STATUS=

ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_MINUTES=

MAX_ACTIVE_DEVICES=

DEVICE_TRUST_SECONDS=

LOGIN_MAX_FAILURES=
LOGIN_FAILURE_WINDOW_SECONDS=
LOGIN_LOCK_SECONDS=
OTP_TTL_SECONDS=
OTP_RESEND_SECONDS=
OTP_WINDOW_SECONDS=
OTP_MAX_REQUESTS=
OTP_IP_MULTIPLIER=
OTP_MAX_ATTEMPTS=


RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW_SECONDS=

RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_SECONDS=

RATE_LIMIT_OTP_REQUEST_MAX=
RATE_LIMIT_OTP_REQUEST_WINDOW_SECONDS=

RATE_LIMIT_OTP_VERIFY_MAX=
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=

RATE_LIMIT_CHAT_MAX=
RATE_LIMIT_CHAT_WINDOW_SECONDS=
RATE_LIMIT_CHAT_IP_MAX=

TELEGRAM_ALERT_DEDUPE_SECONDS=

# Manzil kiritish (xarita/qidiruv). Kalit bo'sh bo'lsa OpenStreetMap ishlatiladi.
YANDEX_GEOCODER_API_KEY=
YANDEX_SUGGEST_API_KEY=

