generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MASTER
  ADMIN
}

enum PortfolioStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED

  DELETED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
  CHANGE_PHONE
}

enum OtpStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  BLOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PolicyType {
  TERMS
  PRIVACY
  PUBLIC_OFFER
  PLATFORM_RULES
  PAYMENT
  REFUND
  CANCELLATION
  WARRANTY
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MasterVerificationStatus {
  PENDING
  UNDER_REVIEW
  CORRECTION_REQUESTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum MasterStatus {
  ACTIVE
  INACTIVE
  BUSY
  RESTRICTED
  SUSPENDED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  MATCHING
  OFFERS_RECEIVED
  BOOKED
  CANCELLED
  EXPIRED
}

enum AttachmentType {
  PHOTO
  VIDEO
  VOICE
  DOCUMENT
  OTHER
}

enum MediaAssetStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum MediaAssetKind {
  PROBLEM_ATTACHMENT
  WORK_PROOF
  MESSAGE_ATTACHMENT
  MASTER_VERIFICATION_DOCUMENT
  MASTER_PORTFOLIO
}

enum MatchingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MatchStatus {
  CANDIDATE
  NOTIFIED
  DECLINED
  EXPIRED
  REMOVED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  MATCHING
  OFFERS_RECEIVED
  BOOKED
  CONFIRMED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  WAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum OrderActor {
  CUSTOMER
  MASTER
  ADMIN
  SYSTEM
}

enum WorkStage {
  BEFORE
  DURING
  AFTER
}

enum AdditionalWorkStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ConversationType {
  ORDER
  SUPPORT
  DIRECT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  CLICK
  PAYME
  UZUM
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundReason {
  CUSTOMER_REQUEST
  DISPUTE
  CANCELLATION
  WARRANTY
  ADMIN_DECISION
  PAYMENT_ERROR
  OTHER
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WarrantyClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
  REMOVED
}

enum CaseType {
  COMPLAINT
  DISPUTE
}

enum CaseStatus {
  REPORTED
  UNDER_REVIEW
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum EvidenceType {
  IMAGE
  VIDEO
  DOCUMENT
  MESSAGE
  WORK_PROOF
  OTHER
}

enum UserActionType {
  WARNING
  FINE
  RESTRICTION
  SUSPENSION
  BAN
}

enum RestrictionType {
  REQUESTS
  OFFERS
  BOOKING
  CHAT
  PAYMENTS
  FULL_ACCOUNT
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

enum CompensationType {
  REFUND
  PARTIAL_REFUND
  CREDIT
  OTHER
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  TELEGRAM
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum VerificationDocumentType {
  IDENTITY
  CERTIFICATE
  LICENSE
  OTHER
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  accountNumber            Int                       @unique @default(autoincrement()) @map("account_number")
  phone                    String                    @unique @db.VarChar(32)
  email                    String?                   @unique @db.VarChar(255)
  passwordHash             String?                   @map("password_hash")
  firstName                String?                   @map("first_name") @db.VarChar(100)
  lastName                 String?                   @map("last_name") @db.VarChar(100)
  avatarUrl                String?                   @map("avatar_url")
  userRoles                UserRole[]
  status                   UserStatus                @default(PENDING)
  phoneVerifiedAt          DateTime?                 @map("phone_verified_at")
  lastLoginAt              DateTime?                 @map("last_login_at")
  preferences              Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?                 @map("deleted_at")
  masterProfile            MasterProfile?
  addresses                Address[]
  refreshTokens            RefreshToken[]
  deviceSessions           DeviceSession[]
  otpCodes                 OtpCode[]
  policies                 PolicyAcceptance[]
  requests                 ProblemRequest[]          @relation("CustomerRequests")
  payments                 Payment[]                 @relation("CustomerPayments")
  ordersAsCustomer         Order[]                   @relation("OrderCustomer")
  bookingsAsCustomer       Booking[]                 @relation("BookingCustomer")
  sentMessages             Message[]                 @relation("MessageSender")
  uploadedWorkProofs       WorkProof[]               @relation("WorkProofUploader")
  reviews                  Review[]                  @relation("ReviewAuthor")
  casesOpened              Case[]                    @relation("CaseOpenedBy")
  casesAgainst             Case[]                    @relation("CaseTarget")
  actions                  UserAction[]              @relation("ActionUser")
  appeals                  Appeal[]
  notifications            Notification[]
  reviewedVerifications    MasterVerification[]      @relation("VerificationReviewer")
  auditLogs                AuditLog[]                @relation("AuditActor")
  outboxEvents             OutboxEvent[]             @relation("OutboxCreator")
  orderStatusHistoryActors OrderStatusHistory[]      @relation("OrderStatusActor")
  additionalWorkRequests   AdditionalWorkRequest[]   @relation("AdditionalWorkRequester")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipants")
  warrantyClaimsOpened     WarrantyClaim[]           @relation("WarrantyClaimOpener")
  compensationsReceived    Compensation[]            @relation("CompensationRecipient")
  mediaAssets              MediaAsset[]              @relation("MediaUploader")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model DeviceSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  deviceId   String        @db.VarChar(255)
  status     SessionStatus @default(ACTIVE)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?     @map("revoked_at")
  userAgent  String?       @map("user_agent") @db.VarChar(400)
  ipAddress  String?       @map("ip_address") @db.VarChar(64)
  panel      String?       @db.VarChar(16)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, status])
  @@map("device_sessions")
}

model RefreshToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.VarChar(255)
  familyId   String        @db.Uuid
  deviceId   String        @db.VarChar(255)
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime      @map("expires_at")
  revokedAt  DateTime?     @map("revoked_at")
  lastSeenAt DateTime      @default(now()) @map("last_seen_at")
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId, status])
  @@index([userId, status])
  @@index([familyId])
  @@index([familyId, deviceId, status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  phone       String     @db.VarChar(32)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  purpose     OtpPurpose
  status      OtpStatus  @default(ACTIVE)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  panel       String?    @db.VarChar(16)
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, status])
  @@index([ipAddress, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PolicyVersion {
  id          String             @id @default(uuid()) @db.Uuid
  type        PolicyType
  version     String             @db.VarChar(50)
  title       String             @db.VarChar(255)
  content     String
  status      PolicyStatus       @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  acceptances PolicyAcceptance[]
  userActions UserAction[]

  @@unique([type, version])
  @@index([type, status])
  @@map("policy_versions")
}

model PolicyAcceptance {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  policyId   String        @db.Uuid
  acceptedAt DateTime      @default(now()) @map("accepted_at")
  ipAddress  String?       @map("ip_address") @db.VarChar(64)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy     PolicyVersion @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([userId, policyId])
  @@index([policyId])
  @@map("policy_acceptances")
}

model Address {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  title       String?          @db.VarChar(100)
  addressLine String           @map("address_line")
  city        String?          @db.VarChar(100)
  district    String?          @db.VarChar(100)
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  isDefault   Boolean          @default(false) @map("is_default")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests    ProblemRequest[]

  @@index([userId])
  @@map("addresses")
}

model MasterProfile {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @unique @db.Uuid
  bio              String?
  profession       String?                  @db.VarChar(150)
  experienceYears  Int?                     @map("experience_years")
  status           MasterStatus             @default(INACTIVE)
  verification     MasterVerificationStatus @default(PENDING)
  workRadiusKm     Decimal?                 @map("work_radius_km") @db.Decimal(8, 2)
  latitude         Decimal?                 @db.Decimal(10, 7)
  longitude        Decimal?                 @db.Decimal(10, 7)
  ratingAvg        Decimal                  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                      @default(0) @map("rating_count")
  completionRate   Decimal                  @default(0) @map("completion_rate") @db.Decimal(5, 2)
  responseRate     Decimal                  @default(0) @map("response_rate") @db.Decimal(5, 2)
  cancellationRate Decimal                  @default(0) @map("cancellation_rate") @db.Decimal(5, 2)
  completedOrders  Int                      @default(0) @map("completed_orders")
  reliabilityScore Decimal                  @default(0) @map("reliability_score") @db.Decimal(5, 2)
  isPaused         Boolean                  @default(false) @map("is_paused")
  pauseReason      String?                  @map("pause_reason") @db.VarChar(255)
  pausedUntil      DateTime?                @map("paused_until")
  serviceAreas     Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         MasterService[]
  portfolio        MasterPortfolio[]
  availability     MasterAvailability[]
  verifications    MasterVerification[]
  matches          MatchingResult[]
  offers           Offer[]
  bookings         Booking[]                @relation("BookingMaster")
  orders           Order[]
  reviews          Review[]
  warranties       Warranty[]

  @@index([status, verification])
  @@index([latitude, longitude])
  @@map("master_profiles")
}

model MasterService {
  id               String        @id @default(uuid()) @db.Uuid
  masterId         String        @db.Uuid
  serviceId        String        @db.Uuid
  description      String?
  basePrice        Decimal?      @map("base_price") @db.Decimal(14, 2)
  estimatedMinutes Int?          @map("estimated_minutes")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  master           MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service          Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([masterId, serviceId])
  @@index([serviceId, isActive])
  @@map("master_services")
}

model MasterPortfolio {
  id           String          @id @default(uuid()) @db.Uuid
  masterId     String          @db.Uuid
  status       PortfolioStatus @default(PENDING)
  reviewedById String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?       @map("reviewed_at")
  rejectReason String?         @map("reject_reason")
  title        String?       @db.VarChar(255)
  description  String?
  mediaAssetId String?       @unique @map("media_asset_id") @db.Uuid
  createdAt    DateTime      @default(now())
  master       MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([masterId])
  @@index([status, createdAt])
  @@map("master_portfolio")
}

model MasterAvailability {
  id             String        @id @default(uuid()) @db.Uuid
  masterId       String        @db.Uuid
  dayOfWeek      Int           @map("day_of_week")
  startTime      String        @map("start_time") @db.VarChar(5)
  endTime        String        @map("end_time") @db.VarChar(5)
  isAvailable    Boolean       @default(true) @map("is_available")
  effectiveFrom  DateTime?     @map("effective_from")
  effectiveUntil DateTime?     @map("effective_until")
  master         MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, dayOfWeek])
  @@map("master_availability")
}

model MasterVerification {
  id              String                   @id @default(uuid()) @db.Uuid
  masterId        String                   @db.Uuid
  documentType    VerificationDocumentType @map("document_type")
  documentUrl     String?                  @map("document_url")
  mediaAssetId    String?                  @unique @map("media_asset_id") @db.Uuid
  status          MasterVerificationStatus @default(PENDING)
  rejectionReason String?                  @map("rejection_reason")
  reviewedById    String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?                @map("reviewed_at")
  expiresAt       DateTime?                @map("expires_at")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  master          MasterProfile            @relation(fields: [masterId], references: [id], onDelete: Cascade)
  reviewedBy      User?                    @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  mediaAsset      MediaAsset?              @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([masterId, status])
  @@map("master_verifications")
}

model ServiceCategory {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(150)
  slug              String             @unique @db.VarChar(180)
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  services          Service[]
  requests          ProblemRequest[]
  aiClassifications AIClassification[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model Service {
  id                String             @id @default(uuid()) @db.Uuid
  categoryId        String             @db.Uuid
  name              String             @db.VarChar(180)
  slug              String             @unique @db.VarChar(200)
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  masterServices    MasterService[]
  requests          ProblemRequest[]
  bookings          Booking[]
  aiClassifications AIClassification[] @relation("AIServiceClassifications")

  @@index([categoryId, isActive])
  @@map("services")
}

model ProblemRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  customerId         String              @db.Uuid
  categoryId         String?             @db.Uuid
  serviceId          String?             @db.Uuid
  addressId          String?             @db.Uuid
  title              String              @db.VarChar(255)
  description        String
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  preferredStartAt   DateTime?           @map("preferred_start_at")
  preferredEndAt     DateTime?           @map("preferred_end_at")
  status             RequestStatus       @default(DRAFT)
  cancellationReason String?             @map("cancellation_reason")
  submittedAt        DateTime?           @map("submitted_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  expiresAt          DateTime?           @map("expires_at")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           User                @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Restrict)
  category           ServiceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service            Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  address            Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  attachments        ProblemAttachment[]
  aiClassifications  AIClassification[]
  matchingRuns       MatchingRun[]
  offers             Offer[]
  booking            Booking?

  @@index([customerId, status, createdAt])
  @@index([categoryId, status])
  @@index([serviceId, status])
  @@index([status, createdAt])
  @@map("problem_requests")
}

model ProblemAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  requestId    String         @db.Uuid
  type         AttachmentType
  storageKey   String         @map("storage_key")
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt         @map("size_bytes")
  createdAt    DateTime       @default(now())
  request      ProblemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("problem_attachments")
}

model AIClassification {
  id                String           @id @default(uuid()) @db.Uuid
  requestId         String           @db.Uuid
  categoryId        String?          @db.Uuid
  serviceId         String?          @db.Uuid
  confidence        Decimal?         @db.Decimal(5, 4)
  possibleQuestions Json?            @map("possible_questions")
  result            Json?
  isAccepted        Boolean?         @map("is_accepted")
  correctedAt       DateTime?        @map("corrected_at")
  createdAt         DateTime         @default(now())
  request           ProblemRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category          ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service           Service?         @relation("AIServiceClassifications", fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([categoryId])
  @@index([serviceId])
  @@map("ai_classifications")
}

model MatchingRun {
  id               String           @id @default(uuid()) @db.Uuid
  requestId        String           @db.Uuid
  status           MatchingStatus   @default(PENDING)
  algorithmVersion String?          @map("algorithm_version") @db.VarChar(50)
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now())
  request          ProblemRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  results          MatchingResult[]

  @@index([requestId, createdAt])
  @@map("matching_runs")
}

model MatchingResult {
  id         String        @id @default(uuid()) @db.Uuid
  runId      String        @db.Uuid
  masterId   String        @db.Uuid
  score      Decimal?      @db.Decimal(8, 4)
  distanceKm Decimal?      @map("distance_km") @db.Decimal(10, 3)
  reason     Json?
  status     MatchStatus   @default(CANDIDATE)
  createdAt  DateTime      @default(now())
  run        MatchingRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  master     MasterProfile @relation(fields: [masterId], references: [id], onDelete: Restrict)

  @@unique([runId, masterId])
  @@index([masterId, createdAt])
  @@map("matching_results")
}

model Offer {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @db.Uuid
  masterId         String         @db.Uuid
  price            Decimal        @db.Decimal(14, 2)
  currency         String         @default("UZS") @db.VarChar(3)
  estimatedMinutes Int?           @map("estimated_minutes")
  message          String?
  availableAt      DateTime?      @map("available_at")
  status           OfferStatus    @default(PENDING)
  expiresAt        DateTime       @map("expires_at")
  createdAt        DateTime       @default(now())
  request          ProblemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  master           MasterProfile  @relation(fields: [masterId], references: [id], onDelete: Restrict)
  booking          Booking?

  @@unique([requestId, masterId])
  @@index([requestId, status, expiresAt])
  @@index([masterId, status, createdAt])
  @@map("offers")
}

model Booking {
  id String @id @default(uuid()) @db.Uuid

  requestId  String  @unique @db.Uuid
  offerId    String  @unique @db.Uuid
  customerId String  @db.Uuid
  masterId   String  @db.Uuid
  serviceId  String? @db.Uuid

  scheduledStartAt DateTime? @map("scheduled_start_at")
  scheduledEndAt   DateTime? @map("scheduled_end_at")

  agreedPrice Decimal @map("agreed_price") @db.Decimal(14, 2)
  currency    String  @default("UZS") @db.VarChar(3)

  locationSnapshot Json? @map("location_snapshot")
  serviceSnapshot  Json? @map("service_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  request  ProblemRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  offer    Offer          @relation(fields: [offerId], references: [id], onDelete: Restrict)
  customer User           @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  master   MasterProfile  @relation("BookingMaster", fields: [masterId], references: [id], onDelete: Restrict)
  service  Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  order Order?

  @@index([customerId, createdAt])
  @@index([masterId, createdAt])
  @@index([scheduledStartAt])
  @@map("bookings")
}

model Order {
  id                    String                  @id @default(uuid()) @db.Uuid
  bookingId             String                  @unique @db.Uuid
  customerId            String                  @db.Uuid
  masterId              String                  @db.Uuid
  status                OrderStatus             @default(BOOKED)
  originalAmount        Decimal                 @map("original_amount") @db.Decimal(14, 2)
  additionalAmount      Decimal                 @default(0) @map("additional_amount") @db.Decimal(14, 2)
  finalAmount           Decimal                 @map("final_amount") @db.Decimal(14, 2)
  currency              String                  @default("UZS") @db.VarChar(3)
  platformFee           Decimal?                @map("platform_fee") @db.Decimal(14, 2)
  masterAmount          Decimal?                @map("master_amount") @db.Decimal(14, 2)
  startedAt             DateTime?               @map("started_at")
  completionSubmittedAt DateTime?               @map("completion_submitted_at")
  completedAt           DateTime?               @map("completed_at")
  confirmedAt           DateTime?               @map("confirmed_at")
  cancelledAt           DateTime?               @map("cancelled_at")
  cancellationReason    String?                 @map("cancellation_reason")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  booking               Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer              User                    @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  master                MasterProfile           @relation(fields: [masterId], references: [id], onDelete: Restrict)
  statusHistory         OrderStatusHistory[]
  workProofs            WorkProof[]
  additionalWork        AdditionalWorkRequest[]
  conversation          Conversation?
  payments              Payment[]
  warranty              Warranty?
  review                Review?
  cases                 Case[]

  @@index([customerId, status, createdAt])
  @@index([masterId, status, createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  actorId   String?      @db.Uuid
  actorType OrderActor
  oldStatus OrderStatus?
  newStatus OrderStatus
  reason    String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?        @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model WorkProof {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @db.Uuid
  uploadedById String         @db.Uuid
  stage        WorkStage
  storageKey   String         @map("storage_key")
  mediaType    AttachmentType @map("media_type")
  mediaAssetId String?        @unique @map("media_asset_id") @db.Uuid
  createdAt    DateTime       @default(now())
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation("WorkProofUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([orderId, stage])
  @@index([uploadedById])
  @@map("work_proofs")
}

model AdditionalWorkRequest {
  id            String               @id @default(uuid()) @db.Uuid
  orderId       String               @db.Uuid
  requestedById String               @db.Uuid
  reason        String
  description   String
  amount        Decimal              @db.Decimal(14, 2)
  currency      String               @default("UZS") @db.VarChar(3)
  evidence      Json?
  status        AdditionalWorkStatus @default(PENDING)
  requestedAt   DateTime             @default(now()) @map("requested_at")
  respondedAt   DateTime?            @map("responded_at")
  expiresAt     DateTime?            @map("expires_at")
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy   User                 @relation("AdditionalWorkRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("additional_work_requests")
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  type         ConversationType
  orderId      String?                   @unique @db.Uuid
  directKey    String?                   @unique @map("direct_key") @db.VarChar(80)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")
  roles          String[]     @default([])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("ConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  senderPanel    String?      @map("sender_panel") @db.VarChar(16)
  replyToId      String?      @map("reply_to_id") @db.Uuid
  type           MessageType  @default(TEXT)
  text           String?
  attachments    Json?
  createdAt      DateTime     @default(now())
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  edits          MessageEdit[]
  reactions      MessageReaction[]
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  panel     String   @default("") @db.VarChar(16)
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, panel])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageEdit {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @db.Uuid
  previousText String?  @map("previous_text")
  editedAt     DateTime @default(now()) @map("edited_at")
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
  @@map("message_edits")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  customerId        String          @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(255)
  amount            Decimal         @db.Decimal(14, 2)
  refundedAmount    Decimal         @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  currency          String          @default("UZS") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  failureReason     String?         @map("failure_reason")
  succeededAt       DateTime?       @map("succeeded_at")
  failedAt          DateTime?       @map("failed_at")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer          User            @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
  @@index([customerId, createdAt])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  amount           Decimal      @db.Decimal(14, 2)
  currency         String       @default("UZS") @db.VarChar(3)
  status           RefundStatus @default(PENDING)
  reason           RefundReason
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(255)
  idempotencyKey   String?      @unique @map("idempotency_key") @db.VarChar(255)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  completedAt      DateTime?    @map("completed_at")
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(255)
  payload     Json
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
  @@map("payment_webhook_events")
}

model Warranty {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @unique @db.Uuid
  masterId   String          @db.Uuid
  startsAt   DateTime        @map("starts_at")
  expiresAt  DateTime        @map("expires_at")
  conditions String?
  status     WarrantyStatus  @default(ACTIVE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  master     MasterProfile   @relation(fields: [masterId], references: [id], onDelete: Restrict)
  claims     WarrantyClaim[]

  @@index([masterId, status])
  @@index([expiresAt, status])
  @@map("warranties")
}

model WarrantyClaim {
  id          String              @id @default(uuid()) @db.Uuid
  warrantyId  String              @db.Uuid
  openedById  String              @db.Uuid
  reason      String
  description String
  status      WarrantyClaimStatus @default(OPEN)
  evidence    Json?
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  resolvedAt  DateTime?           @map("resolved_at")
  warranty    Warranty            @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  openedBy    User                @relation("WarrantyClaimOpener", fields: [openedById], references: [id], onDelete: Restrict)

  @@index([warrantyId, status])
  @@map("warranty_claims")
}

model Review {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  authorId        String        @db.Uuid
  masterProfileId String        @db.Uuid
  rating          Int
  comment         String?
  status          ReviewStatus  @default(PUBLISHED)
  flaggedReason   String?       @map("flagged_reason")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author          User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  master          MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Restrict)

  @@index([masterProfileId, status, createdAt])
  @@map("reviews")
}

model Case {
  id            String         @id @default(uuid()) @db.Uuid
  openedById    String         @db.Uuid
  targetUserId  String?        @db.Uuid
  orderId       String?        @db.Uuid
  type          CaseType
  source        String?        @db.VarChar(50)
  title         String         @db.VarChar(255)
  description   String
  status        CaseStatus     @default(REPORTED)
  decision      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?      @map("resolved_at")
  openedBy      User           @relation("CaseOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  target        User?          @relation("CaseTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  evidence      Evidence[]
  actions       UserAction[]
  appeals       Appeal[]
  compensations Compensation[]

  @@index([openedById, createdAt])
  @@index([targetUserId, status])
  @@index([orderId, status])
  @@map("cases")
}

model Evidence {
  id         String       @id @default(uuid()) @db.Uuid
  caseId     String       @db.Uuid
  type       EvidenceType
  storageKey String?      @map("storage_key")
  text       String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("evidence")
}

model UserAction {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  caseId          String?          @db.Uuid
  policyId        String?          @db.Uuid
  type            UserActionType
  restrictionType RestrictionType?
  reason          String
  startsAt        DateTime         @map("starts_at")
  expiresAt       DateTime?        @map("expires_at")
  liftedAt        DateTime?        @map("lifted_at")
  createdAt       DateTime         @default(now())
  user            User             @relation("ActionUser", fields: [userId], references: [id], onDelete: Restrict)
  case            Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  policy          PolicyVersion?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  appeals         Appeal[]

  @@index([userId, type, expiresAt])
  @@index([caseId])
  @@index([policyId])
  @@map("user_actions")
}

model Appeal {
  id         String       @id @default(uuid()) @db.Uuid
  caseId     String?      @db.Uuid
  actionId   String?      @db.Uuid
  userId     String       @db.Uuid
  status     AppealStatus @default(OPEN)
  reason     String
  decision   String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?    @map("resolved_at")
  case       Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  action     UserAction?  @relation(fields: [actionId], references: [id], onDelete: SetNull)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([caseId])
  @@index([actionId])
  @@map("appeals")
}

model Compensation {
  id          String           @id @default(uuid()) @db.Uuid
  caseId      String?          @db.Uuid
  recipientId String           @db.Uuid
  type        CompensationType
  amount      Decimal?         @db.Decimal(14, 2)
  currency    String           @default("UZS") @db.VarChar(3)
  reason      String
  createdAt   DateTime         @default(now())
  case        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  recipient   User             @relation("CompensationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([recipientId])
  @@map("compensations")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  title     String              @db.VarChar(255)
  body      String
  template  String?             @db.VarChar(150)
  data      Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  error     String?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([channel, status])
  @@map("notifications")
}

model MediaAsset {
  id                   String              @id @default(uuid()) @db.Uuid
  uploaderId           String              @db.Uuid
  kind                 MediaAssetKind
  status               MediaAssetStatus    @default(UPLOADING)
  quarantineKey        String?             @map("quarantine_key")
  originalKey          String?             @map("original_key")
  thumbnailKey         String?             @map("thumbnail_key")
  mediumKey            String?             @map("medium_key")
  originalName         String              @map("original_name") @db.VarChar(255)
  declaredMimeType     String              @map("declared_mime_type") @db.VarChar(150)
  detectedMimeType     String?             @map("detected_mime_type") @db.VarChar(150)
  sizeBytes            BigInt              @map("size_bytes")
  scanResult           String?             @map("scan_result") @db.VarChar(50)
  rejectionReason      String?             @map("rejection_reason")
  linkedResourceType   String?             @map("linked_resource_type") @db.VarChar(50)
  linkedResourceId     String?             @map("linked_resource_id") @db.Uuid
  attempts             Int                 @default(0)
  lastError            String?             @map("last_error")
  cleanedUpAt          DateTime?           @map("cleaned_up_at")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  uploader             User                @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  workProof            WorkProof?
  portfolioItem        MasterPortfolio?
  verificationDocument MasterVerification?

  @@index([uploaderId, status])
  @@index([linkedResourceType, linkedResourceId])
  @@index([status, updatedAt])
  @@map("media_assets")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(255)
  userId         String   @db.Uuid
  method         String   @db.VarChar(10)
  endpoint       String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(255)
  responseStatus Int?     @map("response_status")
  responseBody   Json?
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now())
  expiresAt      DateTime @map("expires_at")

  @@unique([userId, method, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name") @db.VarChar(150)
  eventVersion  Int          @default(1) @map("event_version")
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  lastError     String?      @map("last_error")
  createdById   String?      @db.Uuid
  createdAt     DateTime     @default(now())
  createdBy     User?        @relation("OutboxCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(150)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  device     String?
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
